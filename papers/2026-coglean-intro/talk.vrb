\frametitle{The theorem, in Lean}
\begin{Verbatim}[fontsize=\footnotesize, breaklines=false]
theorem dominant_strengthening_never_raises_backup
    (as : List Answer) (s : Answer → Rat)
    (inc cc : Rat) (p : Problem) (hs : ∀ a, 0 ≤ s a) (hinc : 0 ≤ inc)
    (hT : 0 < total as s)
    (hdom : ∀ a ∈ as, s a ≤ s p.sum) (n k : Nat) :
    prob (search as (strengthen s inc p.sum p.sum) cc k n) Retrieval.isExhausted ≤
      prob (search as s cc k n) Retrieval.isExhausted
\end{Verbatim}
  \small
  \begin{itemize}
    \item \code{hdom}: Chris's condition, the correct answer is the strongest.
    \item \code{strengthen}: DOA's own learning rule (A6), no renormalizing.
    \item Conclusion: exhaustion, so backup use, is no more likely after learning, at every criterion \code{cc} and search length \code{n}.
    \item The proof cites \code{correct\_strengthening\_never\_raises\_backup}, which cites CogLib's \code{exhausted\_boost}.
  \end{itemize}
